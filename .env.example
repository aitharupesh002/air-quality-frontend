# Copy this file to .env for local development, or set the same key
# in your deployment platform's environment variable settings.

# Local backend (default when running the backend with `mvn spring-boot:run`)
VITE_API_BASE_URL=http://localhost:8080

# When deployed, point this at your Render backend URL instead, e.g:
# VITE_API_BASE_URL=https://air-quality-backend.onrender.com
